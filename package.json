{
  "name": "erp-ludus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3020",
    "build": "next build",
    "start": "next start -p 3020",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env.test.local --import ./tests/register.mjs --test \"tests/*.test.ts\"",
    "db:migrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:import-supplier-catalog": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local --import ./scripts/register.mjs scripts/db-import-supplier-catalog.ts",
    "db:import-products": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local --import ./scripts/register.mjs scripts/db-import-products.ts"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "next": "16.2.9",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
