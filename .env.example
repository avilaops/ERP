# Copie para .env.local e ajuste. Nunca comite o arquivo com valores reais.

# Segredo que assina o cookie avila_sso. Tem que ser o mesmo do auth.avilaops.com.
# Em produção: 32 caracteres ou mais, e este valor de exemplo é recusado.
SSO_JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Endereço público deste sistema, sem barra no fim. Usado no returnTo do login.
# Em produção tem que ser https.
APP_URL=http://localhost:3020

# Quem entra e com qual perfil: email:PERFIL separados por vírgula.
# Perfis: DIRETORIA, GERENTE_COMERCIAL, VENDEDOR, FINANCEIRO.
ERP_USERS=diretoria@teste.local:DIRETORIA,gerente@teste.local:GERENTE_COMERCIAL,vendedor@teste.local:VENDEDOR,financeiro@teste.local:FINANCEIRO

# Login local (/dev/login, um usuário de teste por perfil, cookie sem assinatura).
# Já vem ligado no `npm run dev` pelo arquivo .env.development, e o servidor de
# desenvolvimento só escuta em 127.0.0.1. Só vale com NODE_ENV development ou test; em
# produção é ignorada. Para testar o login de verdade em desenvolvimento, desligue aqui:
# ERP_LOCAL_LOGIN=0

# Banco PostgreSQL próprio do ERP (única variável de conexão do sistema).
# Em produção é obrigatória: sem ela o processo não sobe.
DATABASE_URL=postgresql://erp:troque-a-senha@127.0.0.1:5432/erp

# Banco dos testes automatizados. Fica em .env.test.local, não aqui, e o nome do banco
# tem que terminar em _test. Sem ela os testes de banco são pulados.
# ERP_TEST_DATABASE_URL=postgresql://erp:troque-a-senha@127.0.0.1:5432/erp_test
